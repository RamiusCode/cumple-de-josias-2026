---
// src/components/Portada.astro
---

<script is:inline>
    (function() {
        var vh = window.innerHeight * 0.01;
        document.documentElement.style.setProperty('--vh', vh + 'px');
        window.addEventListener('resize', function() {
            var vh = window.innerHeight * 0.01;
            document.documentElement.style.setProperty('--vh', vh + 'px');
        });
    })();
</script>

<div
    id="capa-blanca"
    style="position: fixed; inset: 0; background: #ffffff; z-index: 9999; opacity: 1; pointer-events: none;"
>
</div>

<section
    id="portada-section"
    style="
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        margin: 0 auto;
        width: 100%;
        max-width: 430px;
        height: calc(var(--vh, 1vh) * 100);
        z-index: 10000;
        overflow: hidden;
    "
>
    <!-- Fondo completo -->
    <img
        src="/imagenes/fondoinvitacion.png"
        style="
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
            object-position: center center;
            z-index: 0;
            pointer-events: none;
        "
    />

    <!-- SOBRE.PNG — centro clickeable -->
    <div
        id="sobre-container"
        style="
            position: absolute;
            top: 54%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
            cursor: pointer;
            width: 280px;
        "
    >
        <img
            src="/imagenes/sobre.png"
            id="sobre-img"
            style="
                width: 100%;
                max-width: 410px;
                min-width: 160px;
                height: auto;
                filter: drop-shadow(0 0 18px rgba(255,255,255,0.9)) drop-shadow(0 0 35px rgba(255,255,255,0.6)) drop-shadow(0 8px 20px rgba(0,0,0,0.25));
            "
        />
    </div>
</section>

<style>
    body.portada-activa {
        overflow: hidden !important;
        height: 100vh !important;
    }

    #capa-blanca {
        transition: opacity 0.4s ease;
    }

    html,
    body {
        background-color: #ffffff !important;
    }
</style>

<script>
    import { gsap } from "gsap";

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            document.body.classList.add("portada-activa");


            // Estado inicial
            gsap.set("#sobre-container", { opacity: 0, scale: 0.5 });

            // Entrada del sobre
            gsap.to("#sobre-container", {
                opacity: 1,
                scale: 1,
                duration: 0.7,
                ease: "back.out(1.6)",
                delay: 0.3,
            });

            // Pulso suave grande-pequeño
            gsap.to("#sobre-container", {
                scale: 1.05,
                duration: 2.0,
                repeat: -1,
                yoyo: true,
                ease: "sine.inOut",
                delay: 1.2,
            });

            // Hover (desktop)
            const sobreContainer = document.getElementById("sobre-container");

            sobreContainer?.addEventListener("mouseenter", () => {
                gsap.to("#sobre-img", {
                    scale: 1.06,
                    duration: 0.3,
                    ease: "power2.out",
                });
            });

            sobreContainer?.addEventListener("mouseleave", () => {
                gsap.to("#sobre-img", {
                    scale: 1,
                    duration: 0.3,
                    ease: "power2.out",
                });
            });

            // Click: música + salida
            const portadaSection = document.getElementById("portada-section");
            const capaBlanca = document.getElementById("capa-blanca");

            sobreContainer?.addEventListener("click", () => {
                gsap.killTweensOf("#sobre-container");

                const audio = new Audio("/audio/tres.mp3");
                audio.loop = true;
                audio.volume = 0.5;
                audio.play().catch((e) => console.log("Audio bloqueado:", e));
                (window as any).audioGlobal = audio;
                (window as any).estaReproduciendoGlobal = true;
                window.dispatchEvent(new CustomEvent("musica-iniciada"));

                const tlSalida = gsap.timeline();

                tlSalida
                    .to("#sobre-container", {
                        scale: 1.2,
                        opacity: 0,
                        duration: 0.5,
                        ease: "power2.in",
                    })
                    .to(
                        portadaSection,
                        {
                            opacity: 0,
                            duration: 0.5,
                            ease: "power2.in",
                            onStart: () => {
                                document.body.classList.remove(
                                    "portada-activa",
                                );
                                document.body.style.overflow = "auto";
                            },
                            onComplete: () => {
                                portadaSection?.remove();
                                gsap.to(capaBlanca, {
                                    opacity: 0,
                                    duration: 0.4,
                                    ease: "power2.out",
                                    onComplete: () => capaBlanca?.remove(),
                                });
                                window.scrollTo({ top: 0, behavior: "smooth" });
                            },
                        },
                        0.3,
                    );
            });
        });
    }
</script>
