---
// src/components/Portada.astro
---

<div
    id="capa-blanca"
    style="position: fixed; inset: 0; background: #ffffff; z-index: 9999; opacity: 1; pointer-events: none;"
>
</div>

<section
    id="portada-section"
    style="
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    "
>
    <!-- Wrapper con el mismo aspect ratio que fondoinvitacion.png -->
    <div
        id="portada-wrapper"
        style="
            position: relative;
            width: 100%;
            max-width: 430px;
            max-height: 100%;
            aspect-ratio: auto;
        "
    >
        <img
            id="fondo-img"
            src="/imagenes/fondoinvitacion.png"
            style="
                width: 100%;
                height: auto;
                display: block;
            "
        />

        <!-- SOBRE.PNG — posicionado sobre la imagen con % -->
        <div
            id="sobre-container"
            style="
                position: absolute;
                top: 52%;
                left: 50%;
                transform: translate(-50%, -50%);
                z-index: 10;
                cursor: pointer;
                width: 65%;
            "
        >
            <img
                src="/imagenes/sobre.png"
                id="sobre-img"
                style="
                    width: 100%;
                    height: auto;
                    display: block;
                    filter: drop-shadow(0 0 18px rgba(255,255,255,0.9)) drop-shadow(0 0 35px rgba(255,255,255,0.6)) drop-shadow(0 8px 20px rgba(0,0,0,0.25));
                "
            />
        </div>
    </div>
</section>

<style>
    body.portada-activa {
        overflow: hidden !important;
    }

    #capa-blanca {
        transition: opacity 0.4s ease;
    }

    html,
    body {
        background-color: #ffffff !important;
    }
</style>

<script>
    import { gsap } from "gsap";

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            document.body.classList.add("portada-activa");

            // Estado inicial
            gsap.set("#sobre-container", { opacity: 0, scale: 0.5 });

            gsap.to("#sobre-container", {
                opacity: 1,
                scale: 1,
                duration: 0.7,
                ease: "back.out(1.6)",
                delay: 0.3,
            });

            gsap.to("#sobre-container", {
                scale: 1.05,
                duration: 2.0,
                repeat: -1,
                yoyo: true,
                ease: "sine.inOut",
                delay: 1.2,
            });

            const sobreContainer = document.getElementById("sobre-container");

            sobreContainer?.addEventListener("mouseenter", () => {
                gsap.to("#sobre-img", { scale: 1.06, duration: 0.3, ease: "power2.out" });
            });

            sobreContainer?.addEventListener("mouseleave", () => {
                gsap.to("#sobre-img", { scale: 1, duration: 0.3, ease: "power2.out" });
            });

            const portadaSection = document.getElementById("portada-section");
            const capaBlanca = document.getElementById("capa-blanca");

            sobreContainer?.addEventListener("click", () => {
                gsap.killTweensOf("#sobre-container");

                const audio = new Audio("/audio/tres.mp3");
                audio.loop = true;
                audio.volume = 0.5;
                audio.play().catch((e) => console.log("Audio bloqueado:", e));
                (window as any).audioGlobal = audio;
                (window as any).estaReproduciendoGlobal = true;
                window.dispatchEvent(new CustomEvent("musica-iniciada"));

                const tlSalida = gsap.timeline();

                tlSalida
                    .to("#sobre-container", {
                        scale: 1.2,
                        opacity: 0,
                        duration: 0.5,
                        ease: "power2.in",
                    })
                    .to(
                        portadaSection,
                        {
                            opacity: 0,
                            duration: 0.5,
                            ease: "power2.in",
                            onStart: () => {
                                document.body.classList.remove("portada-activa");
                                document.body.style.overflow = "auto";
                            },
                            onComplete: () => {
                                portadaSection?.remove();
                                gsap.to(capaBlanca, {
                                    opacity: 0,
                                    duration: 0.4,
                                    ease: "power2.out",
                                    onComplete: () => capaBlanca?.remove(),
                                });
                                window.scrollTo({ top: 0, behavior: "smooth" });
                            },
                        },
                        0.3,
                    );
            });
        });
    }
</script>
