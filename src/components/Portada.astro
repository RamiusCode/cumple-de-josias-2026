---
// src/components/Portada.astro
---

<style>
    html, body {
        overflow: hidden;
        margin: 0;
        padding: 0;
        background: #fff;
    }
    #capa-blanca {
        transition: opacity 0.4s ease;
    }
</style>

<div id="capa-blanca" style="position:fixed;inset:0;background:#fff;z-index:9999;opacity:1;pointer-events:none;"></div>

<section id="portada-section" style="position:fixed;inset:0;z-index:10000;overflow:hidden;display:flex;justify-content:center;align-items:flex-start;cursor:pointer;">

    <div id="portada-wrapper" style="position:relative;width:100%;max-width:430px;">
        <img
            id="fondo-portada"
            src="/imagenes/fondoinvitacion.png"
            style="width:100%;height:auto;display:block;"
        />
    </div>

</section>

<script>
    import { gsap } from "gsap";

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {

            gsap.set("#portada-wrapper", { opacity: 0 });
            gsap.to("#portada-wrapper", {
                opacity: 1, duration: 0.6, ease: "power2.out", delay: 0.2,
            });

            const portadaSection = document.getElementById("portada-section");
            const capaBlanca = document.getElementById("capa-blanca");

            portadaSection?.addEventListener("click", () => {

                const audio = new Audio("/audio/tres.mp3");
                audio.loop = true;
                audio.volume = 0.5;
                audio.play().catch((e) => console.log("Audio bloqueado:", e));
                (window as any).audioGlobal = audio;
                (window as any).estaReproduciendoGlobal = true;
                window.dispatchEvent(new CustomEvent("musica-iniciada"));

                gsap.timeline()
                    .to(portadaSection, {
                        opacity: 0, duration: 0.5, ease: "power2.in",
                        onStart: () => {
                            document.body.style.overflow = "auto";
                            document.documentElement.style.overflow = "auto";
                        },
                        onComplete: () => {
                            portadaSection?.remove();
                            gsap.to(capaBlanca, {
                                opacity: 0, duration: 0.4, ease: "power2.out",
                                onComplete: () => capaBlanca?.remove(),
                            });
                            window.scrollTo({ top: 0, behavior: "smooth" });
                        },
                    });
            });
        });
    }
</script>
